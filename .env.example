# Copy to .env and fill in. Never commit .env.

# openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# SQLite for a quick start, PostgreSQL for production
DATABASE_URL=sqlite:///taksunusa.db
# DATABASE_URL=postgresql+psycopg2://taksunusa:CHANGE_ME@db:5432/taksunusa
DB_PASSWORD=CHANGE_ME

# Host port nginx proxies to. Change it if something already uses 5200 —
# check with: sudo ss -lntp | grep <port>
APP_PORT=5200

# Set to false only when running plain HTTP locally
SESSION_COOKIE_SECURE=true

SITE_URL=https://taksunusaspa.com
DEFAULT_LANG=en

# Order + booking alerts (optional, leave empty to disable)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT=

# ---------------------------------------------------------------- WhatsApp
# Notifications only. Booking, changing and cancelling always happen on the
# website — WhatsApp never creates or alters a booking, and a booking is never
# delayed or lost when WhatsApp is unavailable.
#
#   meta            — Meta Cloud API. The production route.
#   fonnte / wablas — Indonesian gateways that drive a linked handset. Useful
#                     while Meta verification and template approval are
#                     pending; they are not the official API.
#   none            — nothing is sent. Bookings still work; the admin screens
#                     show one-tap links you press send on yourself.
WA_PROVIDER=none
WA_TOKEN=
# Wablas only: your Wablas domain, e.g. https://sg.wablas.com
WA_API_URL=
# Meta only:
WA_PHONE_ID=

# Meta only. A booking confirmation goes to someone who has not messaged us
# first, which Meta treats as business-initiated: it must be a Utility
# template approved in advance, never free text. Create it in WhatsApp
# Manager, then put its name here. With this empty, nothing is sent to the
# customer and the reason is recorded in Admin -> Alerts.
#
# The template body must take seven parameters, in this order:
#   {{1}} booking code     {{2}} service and duration   {{3}} date
#   {{4}} time             {{5}} address or area        {{6}} status
#   {{7}} manage booking link
#
# Suggested body:
#   Taksu Nusa Spa - Booking {{6}}
#   Booking: {{1}}
#   Service: {{2}}
#   Date: {{3}}
#   Time: {{4}}
#   Address: {{5}}
#   Manage or cancel your booking: {{7}}
#
# Cost, checked September 2026: Utility templates are billed per message.
# They were free inside the 24-hour customer service window from 1 Jul 2025,
# but from 1 Oct 2026 Meta charges for them there too. Each business number
# gets 1,000 free service messages a month; after that every confirmation
# costs. Budget for it — proactive customer messages are not free.
WA_TEMPLATE_BOOKING=
WA_TEMPLATE_LANG=en

# ------------------------------------------------------------------- e-mail
# Confirmations to the guest (when they give an address) and to the owner.
# Best-effort: an unreachable mail server never fails a booking.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Taksu Nusa Spa <bookings@taksunusaspa.com>
MAIL_SECURITY=starttls
# Where the owner's copy of each booking goes.
ADMIN_EMAIL=

# The spa's own number, shown on Contact for enquiries. Never a
# therapist number, and never used to take a booking.
WHATSAPP_NUMBER=6282339566156

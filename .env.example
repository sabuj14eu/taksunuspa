# Copy to .env and fill in. Never commit .env.

# openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# SQLite for a quick start, PostgreSQL for production
DATABASE_URL=sqlite:///taksunusa.db
# DATABASE_URL=postgresql+psycopg2://taksunusa:CHANGE_ME@db:5432/taksunusa
DB_PASSWORD=CHANGE_ME

# Host port nginx proxies to. Change it if something already uses 5200 —
# check with: sudo ss -lntp | grep <port>
APP_PORT=5200

# Set to false only when running plain HTTP locally
SESSION_COOKIE_SECURE=true

SITE_URL=https://taksunusaspa.com
DEFAULT_LANG=en

# Order + booking alerts (optional, leave empty to disable)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT=

# Automatic WhatsApp. A website cannot message a WhatsApp number on its own —
# it needs an account with a provider. Leave WA_PROVIDER=none and the admin
# screens fall back to one-tap wa.me links you press send on yourself.
#   fonnte / wablas — Indonesian gateways, scan a QR with the spa's phone
#   meta            — Meta Cloud API (needs WA_PHONE_ID; templates apply
#                     outside a 24h window since the customer messaged you)
WA_PROVIDER=none
WA_TOKEN=
# Wablas only: your Wablas domain, e.g. https://sg.wablas.com
WA_API_URL=
# Meta only:
WA_PHONE_ID=

# WhatsApp number used for the "order via WhatsApp" fallback button
WHATSAPP_NUMBER=6282339566156
